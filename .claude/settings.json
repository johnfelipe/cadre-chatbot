{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Read(./node_modules/next/dist/docs/**)",
      "Read(./node_modules/ai/docs/**)",
      "WebFetch(domain:cadreai.com)",
      "WebFetch(domain:www.cadreai.com)"
    ],
    "ask": [
      "Bash(npm run eval*)",
      "Bash(npm install*)",
      "Bash(npx vercel*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
